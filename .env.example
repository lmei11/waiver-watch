# Copy this file to ".env" (same folder as waiver_watch.py) and fill in your values.

# Your league ID (the number after leagueId= in your league's URL). Lets you omit --league.
ESPN_LEAGUE_ID=123456789

# ntfy.sh topic for phone push notifications. Pick something long and hard to guess,
# since anyone who knows the topic name can read it. Subscribe to it in the ntfy app.
NTFY_TOPIC=pick-a-long-random-topic-name

# Hours to poll in, local time, 24h clock. Defaults to 3-5 (3:00-5:00 AM) if left out.
# WAIVER_WINDOW=3-5

# Only needed for private leagues. Keep .env private - these are effectively your ESPN login.
ESPN_S2=paste_your_long_espn_s2_value_here
ESPN_SWID={PASTE-YOUR-SWID-HERE}
